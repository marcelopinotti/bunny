# ===== RabbitMQ (compartilhado pelos dois serviços) =====
# local, do compose.yaml da raiz
#RABBIT_HOST=localhost
#RABBIT_PORT=5672
#RABBIT_USER=myuser
#RABBIT_PASSWORD=changeme
#RABBIT_VHOST=/
#RABBIT_SSL=false

# CloudAMQP: descomente e comente o bloco acima quando for usar
RABBIT_HOST=seu-host.lmq.cloudamqp.com
RABBIT_PORT=5671
RABBIT_USER=seu-usuario
RABBIT_PASSWORD=changeme
RABBIT_VHOST=seu-usuario
RABBIT_SSL=true

# ===== AWS / DynamoDB =====
# local: DynamoDB Local do compose.yaml da raiz; na AWS deixe DYNAMODB_ENDPOINT vazio
#AWS_REGION=us-east-1
#DYNAMODB_ENDPOINT=http://localhost:8000
#DYNAMODB_EMAIL_TABLE=emails
#DYNAMODB_USER_TABLE=users

# ===== SMTP (email-service) =====
# Gmail: precisa da verificação em 2 etapas ativa e de uma senha de app
# (Conta Google > Segurança > Senhas de app). A senha normal da conta não funciona.
# Sem MAIL_FROM o remetente é o próprio MAIL_USERNAME (o Gmail troca qualquer outro mesmo).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-letras

# Mailtrap sandbox (alternativa para testes): descomente e comente o bloco acima
#MAIL_HOST=sandbox.smtp.mailtrap.io
#MAIL_PORT=2525
#MAIL_USERNAME=seu-usuario-mailtrap
#MAIL_PASSWORD=changeme
#MAIL_FROM=no-reply@bunny.dev
